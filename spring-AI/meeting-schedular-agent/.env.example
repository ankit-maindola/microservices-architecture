GEMINI_API_KEY=your-gemini-api-key-from-aistudio-google-com
GEMINI_MODEL=gemini-2.0-flash
# Faster NL parsing (one small Gemini call); optional override:
# GEMINI_INTENT_MODEL=gemini-2.0-flash
# Log prompts/options sent to Gemini (API key is never logged):
# GEMINI_LOG_REQUESTS=true
# Optional alias:
# GOOGLE_API_KEY=your-gemini-api-key-from-aistudio-google-com
DB_HOST=localhost
DB_PORT=3306
DB_NAME=meetings
DB_USER=meeting_user
DB_PASSWORD=meeting_pass
MEETING_DEFAULT_TIME_ZONE=Asia/Kolkata
SERVER_PORT=8080
# If you see PKIX / certificate_unknown errors (corporate proxy):
# SSL_TRUST_STORE=C:/Users/you/corp-truststore.jks
# SSL_TRUST_STORE_PASSWORD=changeit
